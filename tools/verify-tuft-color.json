  {"op":"eval","js":"(()=>{const d=window.__dbg,img=d.tufts.material.map.image;const c=document.createElement('canvas');c.width=img.width;c.height=img.height;const g=c.getContext('2d');g.drawImage(img,0,0);const dt=g.getImageData(0,0,img.width,img.height).data;const hex=v=>'#'+v.map(x=>Math.max(0,Math.min(255,Math.round(x))).toString(16).padStart(2,'0')).join('');const band=(y0,y1)=>{let r=0,gg=0,b=0,n=0;for(let y=Math.round(y0);y<Math.round(y1);y++)for(let x=0;x<img.width;x++){const i=(y*img.width+x)*4;if(dt[i+3]<200)continue;r+=dt[i];gg+=dt[i+1];b+=dt[i+2];n++;}return n?{hex:hex([r/n,gg/n,b/n]),n}:null;};return {tex:{bottom:band(img.height*0.86,img.height),mid:band(img.height*0.45,img.height*0.60),top:band(img.height*0.05,img.height*0.20)},tuftBlade:d.config.grassColors.tuftBlade,tuftTintLight:d.config.grassColors.tuftTintLight,bladePalette:[d.config.grassColors.blade[0],d.config.grassColors.blade[1]]};})()"},
