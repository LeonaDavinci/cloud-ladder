[
  {"op":"waitFor","js":"!!(window.__dbg && window.__dbg.bed && window.__dbg.bed.children.length>0)"},
  {"op":"wait","ms":3500},
  {"op":"eval","js":"(()=>{const d=window.__dbg,b=d.bed;b.updateMatrixWorld(true);const V=d.THREE.Vector3,Box=d.THREE.Box3;const kids=b.children.map(o=>{const bb=new Box();let meshes=0;o.traverse(x=>{if(x.isMesh){meshes++;bb.expandByObject(x);}});return {name:o.name||o.type,visible:o.visible,meshes,min:bb.isEmpty()?null:bb.min.toArray().map(v=>+v.toFixed(3)),max:bb.isEmpty()?null:bb.max.toArray().map(v=>+v.toFixed(3))};});return {bedChildren:kids.length,bedPos:b.position.toArray().map(v=>+v.toFixed(3)),rotY:+b.rotation.y.toFixed(4),kids};})()"},
  {"op":"eval","js":"(()=>{const d=window.__dbg,b=d.bed;b.updateMatrixWorld(true);let vis=0,hid=0;b.traverse(o=>{if(o.isMesh){o.visible?vis++:hid++;}});const box=new d.THREE.Box3();b.traverse(o=>{if(o.isMesh&&o.visible)box.expandByObject(o);});return {visibleMeshes:vis,hiddenMeshes:hid,visBoxMin:box.min.toArray().map(v=>+v.toFixed(3)),visBoxMax:box.max.toArray().map(v=>+v.toFixed(3)),size:box.getSize(new d.THREE.Vector3()).toArray().map(v=>+v.toFixed(3))};})()"},
  {"op":"eval","js":"(()=>{const d=window.__dbg,b=d.bed;let glb=null;b.children.forEach(o=>{if(o!==b&&o.type==='Group'||o.isObject3D&&!o.isMesh&&o.children.length)glb=o;});return {childTypes:b.children.map(o=>o.type+':'+(o.isMesh?'mesh':'grp')+':'+o.children.length+':'+(o.visible?'vis':'hid'))};})()"}
]
