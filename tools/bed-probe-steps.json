  {"op":"eval","js":"(()=>{const d=window.__dbg,T=d.THREE,out=[];d.bed.updateMatrixWorld(true);d.bed.traverse(o=>{if(!o.isMesh)return;const b=new T.Box3().setFromObject(o);const sz=b.getSize(new T.Vector3());out.push({n:o.name||o.type,vis:o.visible,ymin:+b.min.y.toFixed(2),ymax:+b.max.y.toFixed(2),w:+sz.x.toFixed(2),h:+sz.y.toFixed(2),d:+sz.z.toFixed(2)});});return out.slice(0,24);})()"},
