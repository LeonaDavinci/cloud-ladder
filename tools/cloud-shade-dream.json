  {"op":"eval","js":"(function(){var T=__dbg.THREE;window.__orbit=function(azD,elD,r){var ps=__dbg.cloud.userData.puffs,c=new T.Vector3();for(var i=0;i<ps.length;i++)c.add(ps[i].home);c.multiplyScalar(1/ps.length);var a=azD*Math.PI/180,e=(elD||0)*Math.PI/180;var pos=new T.Vector3(c.x+r*Math.cos(e)*Math.sin(a),c.y+r*Math.sin(e),c.z+r*Math.cos(e)*Math.cos(a));var ctl=__dbg.controls;ctl.enableDamping=false;__dbg.camera.position.copy(pos);ctl.target.copy(c);ctl.update();ctl.update();return __dbg.camera.position.toArray().map(function(v){return +v.toFixed(2);});};window.__setShade=function(S){var st=__dbg.atmos.state,stt=__dbg.atmos.states[st]||{};var use=(S&&typeof S==='object')?S:(stt.cloudShade||null);__dbg.shadeCloud(__dbg.sun.position,use);return use;};return 'helpers ready';})()"},

