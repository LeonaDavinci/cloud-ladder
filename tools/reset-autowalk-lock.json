  {"op":"eval","js":"(function(){var m=document.querySelector('meta[name=viewport]');var cs=getComputedStyle(document.body);var de=getComputedStyle(document.documentElement);var cv=document.querySelector('#app canvas');return JSON.stringify({meta:m?m.content:'(none)',userScalableNo:!!m&&/user-scalable\\s*=\\s*no/i.test(m.content),maxScale1:!!m&&/maximum-scale\\s*=\\s*1(\\.0)?(,|\\s|$)/i.test(m.content),htmlUserSelect:de.userSelect||de.webkitUserSelect,bodyUserSelect:cs.userSelect||cs.webkitUserSelect,htmlTouchAction:de.touchAction,canvasTouchAction:getComputedStyle(cv).touchAction,vpHook:!!window.__vp});})()"},

  {"op":"eval","js":"(function(){var cv=document.querySelector('#app canvas');var c=__dbg.camera,o=__dbg.controls;window.__probe={plain:null,ctrl:null};cv.addEventListener('wheel',function(e){if(e.ctrlKey||e.metaKey)window.__probe.ctrl=e.defaultPrevented;else window.__probe.plain=e.defaultPrevented;});var st={d0:c.position.distanceTo(o.target)};var e2=new WheelEvent('wheel',{deltaY:-120,ctrlKey:true,bubbles:true,cancelable:true});cv.dispatchEvent(e2);st.ctrlPrevented=e2.defaultPrevented;st.ctrlReachedCanvas=(window.__probe.ctrl!==null);window.__wheel=st;return JSON.stringify(st);})()"},
