[
  { "op": "waitFor", "js": "!!(window.__dbg && window.__dbg.daisies && window.__dbg.config && window.__dbg.config.bed)" },
  { "op": "wait", "ms": 2600 },

  { "op": "eval", "js": "(()=>{const d=window.__dbg;const e=d.config;const b=new d.THREE.Box3().setFromObject(d.bed);return {avoidHalf:e.bed.avoidHalf,fromPanel:e.daisyClustersFromPanel,bedX:[+b.min.x.toFixed(2),+b.max.x.toFixed(2)],bedZ:[+b.min.z.toFixed(2),+b.max.z.toFixed(2)],avoidMargin:e.bed.avoidMargin};})()" },
  { "op": "eval", "js": "(()=>{const d=window.__dbg;const M=new d.THREE.Matrix4(),v=new d.THREE.Vector3();const B=d.bed;const box=new d.THREE.Box3().setFromObject(B);let inBed=0,tot=0;const scan=(oNode)=>{if(!oNode||!oNode.isInstancedMesh)return;for(let i=0;i<oNode.count;i++){oNode.getMatrixAt(i,M);v.setFromMatrixPosition(M);tot++;if(v.x>box.min.x&&v.x<box.max.x&&v.z>box.min.z&&v.z<box.max.z)inBed++;}};scan(d.grass);scan(d.tufts);const lv=d.lavender;let lvIn=0;if(lv)lv.traverse(o=>{if(o.isInstancedMesh){for(let i=0;i<o.count;i++){o.getMatrixAt(i,M);v.setFromMatrixPosition(M);if(v.x>box.min.x&&v.x<box.max.x&&v.z>box.min.z&&v.z<box.max.z)lvIn++;}}});return JSON.stringify({bladeTuft:tot,insideBedBox:inBed,lavenderInside:lvIn});})()" },

  { "op": "eval", "js": "(()=>{const d=window.__dbg,c=d.camera;c.position.set(-2,7.2,13);d.controls.target.set(-2,1.6,1.0);d.controls.update();return 'front';})()" },
