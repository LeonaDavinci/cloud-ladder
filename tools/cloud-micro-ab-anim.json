[
  {"op":"waitFor","js":"!!(window.__dbg && window.__dbg.cloud && window.__dbg.cloud.userData.puffs && window.__dbg.uTime)"},
  {"op":"wait","ms":1500},

  {"op":"eval","js":"(()=>{window.__dbg.uTime.value=0;return 'T=0';})()"},
  {"op":"waitFor","js":"window.__dbg.time > 0"},

  {"op":"eval","js":"(()=>{const d=window.__dbg,c=d.camera;c.position.set(-2,5.6,27);d.controls.target.set(2.6,13.6,1.6);d.controls.update();return 'cam-ground';})()"},
  {"op":"wait","ms":2600},
  {"op":"shot","file":"cm-b-1-ground.png"},

  {"op":"eval","js":"(()=>{const d=window.__dbg,c=d.camera;c.position.set(2.6,20.5,16);d.controls.target.set(2.6,13.8,1.6);d.controls.update();return 'cam-above';})()"},
  {"op":"wait","ms":2600},
  {"op":"shot","file":"cm-b-2-above.png"},

  {"op":"eval","js":"(()=>{window.__dbg.uTime.value=10.4;return 'T=10.4';})()"},
  {"op":"waitFor","js":"window.__dbg.time > 10.4"},
  {"op":"eval","js":"(()=>{const d=window.__dbg,c=d.camera;c.position.set(-2,5.6,27);d.controls.target.set(2.6,13.6,1.6);d.controls.update();return 'cam-ground-again';})()"},
  {"op":"wait","ms":2600},
  {"op":"shot","file":"cm-b-3-ground-later.png"},

  {"op":"eval","js":"(()=>{const d=window.__dbg,c=d.camera;c.position.set(2.6,20.5,16);d.controls.target.set(2.6,13.8,1.6);d.controls.update();return 'cam-above-again';})()"},
  {"op":"wait","ms":2600},
  {"op":"shot","file":"cm-b-4-above-later.png"},

  {"op":"eval","js":"(()=>{const d=window.__dbg,l=d.cloud.userData.puffs,f=d.cloud.userData.flow;return {t:+d.time.toFixed(2),wind:d.config.cloudWind,puffs:l.length,offMaxNow:+Math.max(...l.map(p=>p.node.position.distanceTo(p.home))).toFixed(3),rotMaxNow:+Math.max(...l.map(p=>Math.abs(p.sp.material.rotation||0))).toFixed(4),errs:(window.__errs||[]).length};})()"},
  {"op":"eval","js":"(()=>{const e=window.__errs||[];return {errs:e.length,list:e.slice(0,3)};})()"}
]
