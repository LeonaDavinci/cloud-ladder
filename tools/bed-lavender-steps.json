  {"op":"eval","js":"(()=>{const d=window.__dbg,T=d.THREE,L=d.lavender,m=new T.Matrix4(),v=new T.Vector3(),b=d.bed.position;let near=0;for(let i=0;i<L.count;i++){L.getMatrixAt(i,m);v.setFromMatrixPosition(m);if(Math.hypot(v.x-b.x,v.z-b.z)<7)near++;}return {lavTotal:L.count,within7m:near};})()"},
