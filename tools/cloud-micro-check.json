  {"op":"eval","js":"(()=>{const d=window.__dbg,f=d.cloud.userData.flow,l=d.cloud.userData.puffs,S=window.__S;const own=l.map(p=>p.w0/1.8);const K=Math.hypot(1,0.45,0.35);let worstB=0,worstOwn=0;for(let i=0;i<l.length;i++){const b=l[i].amp*K;for(const s of S){const q=s.pos[i];const dd=Math.hypot(q[0]-l[i].home.x,q[1]-l[i].home.y,q[2]-l[i].home.z);if(dd/b>worstB)worstB=dd/b;if(dd/own[i]>worstOwn)worstOwn=dd/own[i];}}const cen=[],rms=[];for(const s of S){let cx=0,cy=0,cz=0;for(const p of s.pos){cx+=p[0];cy+=p[1];cz+=p[2];}cx/=s.pos.length;cy/=s.pos.length;cz/=s.pos.length;let r2=0;for(const p of s.pos){r2+=(p[0]-cx)**2+(p[1]-cy)**2+(p[2]-cz)**2;}r2/=s.pos.length;cen.push([+cx.toFixed(3),+cy.toFixed(3),+cz.toFixed(3)]);rms.push(+Math.sqrt(r2).toFixed(3));}const c0=cen[0];const rotMax=Math.max(...S.flatMap(s=>s.rot.map(Math.abs)));const scMin=Math.min(...S.flatMap(s=>s.sc)),scMax=Math.max(...S.flatMap(s=>s.sc));return {samples:S.length,times:S.map(s=>s.t),puffs:l.length,ampRange:[+Math.min(...l.map(p=>p.amp)).toFixed(3),+Math.max(...l.map(p=>p.amp)).toFixed(3)],ownRange:[+Math.min(...own).toFixed(2),+Math.max(...own).toFixed(2)],offOverBoundMath:+(worstB).toFixed(3),offOverOwnSize:+(worstOwn).toFixed(3),rotMax:+rotMax.toFixed(4),rotAmp:f.rotAmp,breathScaledX:[+scMin.toFixed(3),+scMax.toFixed(3)],centroidDriftMax:+Math.max(...cen.map(c=>Math.hypot(c[0]-c0[0],c[1]-c0[1],c[2]-c0[2]))).toFixed(4),rmsPerTime:rms,rmsSpread:+(Math.max(...rms)-Math.min(...rms)).toFixed(4),errs:(window.__errs||[]).length};})()"},
