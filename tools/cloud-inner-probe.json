[
  {"op":"waitFor","js":"!!(window.__dbg && window.__dbg.cloud && window.__dbg.cloud.userData.puffs)"},
  {"op":"wait","ms":1500},
  {"op":"eval","js":"(()=>{const l=window.__dbg.cloud.userData.puffs;const r=l.map(p=>p.rN).sort((a,b)=>a-b);const q=x=>+r[Math.min(r.length-1,Math.floor(x*r.length))].toFixed(3);const wk=l.map(p=>p.wk);return {n:l.length,rN:{min:+r[0].toFixed(3),p10:q(0.10),p25:q(0.25),p50:q(0.50),p75:q(0.75),p90:q(0.90),p97:q(0.97),max:+r[r.length-1].toFixed(3)},wkFull:wk.filter(v=>v>0.99).length,wkZero:wk.filter(v=>v<0.002).length,wkMean:+(wk.reduce((a,b)=>a+b,0)/wk.length).toFixed(3)};})()"},
  {"op":"eval","js":"(()=>{const d=window.__dbg,f=d.cloud.userData.flow,l=d.cloud.userData.puffs;return {flow:{drift:f.drift,rate:f.rate,rot:f.rotAmp,rotRate:f.rotRate,breathe:f.breathe,inner:[f.IN_LO,f.IN_HI]},ampMax:+Math.max(...l.map(p=>p.amp)).toFixed(3),ampMean:+(l.map(p=>p.amp).reduce((a,b)=>a+b,0)/l.length).toFixed(3)};})()"},
  {"op":"eval","js":"(()=>{const e=window.__errs||[];return {errs:e.length,list:e.slice(0,3)};})()"}
]
